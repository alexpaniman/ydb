  "finite_execution_order": [
    {
      "action": "Apply only after independent review and complete source freeze; verify exact idle53 predecessor and all7 after-images; regenerate affected profile fingerprints before reuse.",
      "step": 1
    },
    {
      "action": "Run existing exact fixed42 and canonical baseline/fixed652 with current driver/oracles/guards; preserve all failures. New allocator fields require fresh direct evidence.",
      "step": 2
    },
    {
      "action": "Generate fresh manifest(2048,run_id). Serial30 path-pilot cells in profile order, baseline then fixed, use existing invoke_native one-cell opt-in with kind=pilot,index=0,rows=2048,repetitions=1. Owner stamps quality_profile_sha256 only after stable before/after source checks.",
      "step": 3
    },
    {
      "action": "Validate exact pilot30. Unknown shape is a precise blocked witness, not count-based success; review actual non-persisted lowering before adapting any observer.",
      "step": 4
    },
    {
      "action": "Only after actual path approval freeze one supported N and a StageB contract digest at native dispatch. Reuse reviewed sole-child protocol; collect exactly schedule180, retain all samples and guard failures. Raw validator already implemented; it cannot grant optimization admission.",
      "step": 5
    },
    {
      "action": "Review finite measured scope and explicit source work/allocation invariants. Keep overlapping/setup-dominated timing inconclusive; no endlessly larger experiments beyond the existing bounded N ladder. Full promotion requires an independently reviewed StageB acceptance integration, not manual flags.",
      "step": 6
    }
  ],
