  "proof": {
    "initial_service_accounted_bytes": 0,
    "channel_v2_mandatory_header_min_bytes": 36,
    "channel_v2_header_terms": "four ui32 + four bool + two ui64; checkpoint/watermark optional extensions only add bytes",
    "channel_v1_mandatory_header_min_bytes": 20,
    "channel_v1_64bit_header_bytes": 28,
    "remaining_hash_aggregation_min_blob_bytes": 2,
    "remaining_hash_aggregation_minimum_reason": "Scalar packed batch has a length metadata byte plus a packed item-count byte. Adapter skips empty buffers; even hypothetical zero-row Finish contains both fields. Null/empty scalar values cannot remove either field.",
    "compute_mask_limit": "None disables mask-controlled GraceJoin, sort, and generic aggregation spills. New RBO hash aggregation bypasses this mask and remains covered by its minimum serialized size.",
    "ineffective_override_omitted": "EnableDqHashAggregateByDefault=false only gates the legacy rewrite; New RBO directly emits the physical node, so this override would not establish a no-compute-spill condition.",
    "block_and_compression": "DqHashAggregate converts block inputs to unpacked scalar row types for both adapters; no compressed stream bypasses their packer. Any channel transport compression remains inside the outer mandatory channel envelope. Local service writes the whole checked blob without a second codec path.",
    "all_payload_file_write_modes": "The single TWriteFileOp is queued only after the size check; both CreateAlways and ForAppend are inside that operation. TEvOpenFile is bookkeeping only. Read/close handlers do not write payloads.",
    "cap_argument": "Each reachable nonempty blob is greater than one byte. With fresh service total zero, each write returns at cap check before accounting/filename/queue/open/create/append. By induction no payload write is queued and total remains zero. Controlled 24-row profiles cannot approach integer-overflow sizes.",
    "zero_cap_is_not_safe": "MaxTotalSize=0 disables the limit, it does not disable payload writes.",
    "not_a_general_file_policy": "A one-byte raw blob from another caller could be accepted. This is a source-bound contract for these two scalar profiles and reviewed transport paths, not arbitrary workloads."
  },
  "other_persistence_paths": {
    "runner": "Actual executable path is kqprun TYdbSetup/TKikimrSetupBase; TKikimrRunner was only corroborating background.",
    "database_disk": "No PDisksPath or disk override supplied by native_verify; one-node default fake storage uses memory. A disk-path option would invalidate this audit.",
    "files_and_logs": "Existing helper supplies config/schema/fixtures/query/results/physical AST via anonymous descriptors, log output /dev/null, core size zero. No named query/result file or timeline option is added.",
    "empty_directory": "Enabled service still creates an empty per-session directory in its configured/default temporary root; cleanup=false may leave that directory. It contains no workload row or query-text payload under the cap proof.",
    "why_service_not_disabled": "Channel storage opens bookkeeping eagerly; disabling the service can produce Spilling Service not started even before a payload spill and also removes the global flag used for sharing.",
    "why_not_rlimit_fsize": "RLIMIT_FSIZE=0 also blocks anonymous memfd result/AST writes."
